# =============================================================================
#  secrets.local.example — tracked template for building the release APK.
#
#  On any new machine: copy this file to `secrets.local`, then fill in the two
#  password lines from your OFFLINE backup (C:\Keystores\qandparsi-upload.jks
#  + its passwords). Never commit the real secrets.local.
#
#  The values below that are already filled in are PUBLIC configuration:
#    - BAZAAR_RSA_PUBLIC_KEY = your Cafe Bazaar in-app billing RSA public key
#      (safe to keep in the repo because it is embedded in the APK itself).
#    - TAPSELL_* = your Tapsell app key / zone ids (also embedded in the APK).
#  The keystore path and passwords are SECRET and must be kept offline.
# =============================================================================
KEYSTORE_PATH=C:\Keystores\qandparsi-upload.jks
STORE_PASSWORD=PUT_YOUR_STORE_PASSWORD_HERE
KEY_PASSWORD=PUT_YOUR_KEY_PASSWORD_HERE
TAPSELL_APP_KEY=pcgalhaftgjkqbfbaqirimmfrclnnctcmrdalctdqifiisijtgsigargplshnegkjggoop
TAPSELL_BANNER_ZONE_ID=6af601d93499d037a4e325fc
TAPSELL_REWARDED_ZONE_ID=6af601adeb3e7c7d8f0f0faf
